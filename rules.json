    "normalization": {
        "description": "Since different users see different branches, normalize based on questions seen",
        "method": "normalized = round((points_earned / points_possible_seen) * 100)"
    },
    "style_rules": {
        "direct_initiator": {
            "conditions": [
                "initiation_confidence >= 75",
                "social_openness >= 65"
            ]
        },
        "context_based_connector": {
            "conditions": [
                "shared_context_reliance >= 70",
                "low_pressure_preference < 75"
            ]
        },
        "low_pressure_connector": {
            "conditions": [
                "low_pressure_preference >= 75",
                "digital_comfort >= 60"
            ]
        },
        "warm_up_socializer": {
            "conditions": [
                "low_pressure_preference >= 65",
                "initiation_confidence between 35 and 65",
                "Q7 = wait_for_someone OR observe_first"
            ]
        },
        "selective_socializer": {
            "conditions": [
                "social_openness between 40 and 70",
                "shared_context_reliance between 40 and 70",
                "Q1 = sometimes OR prefer_known_people"
            ]
        },
        "familiar_circle_preferer": {
            "conditions": [
                "social_openness < 40",
                "initiation_confidence < 40"
            ]
        }
    },
    "result_templates": {
        "warm_up_socializer": "You tend to ease into new interactions rather than jumping in immediately. You may feel most comfortable when there’s time to observe, a shared context, or a lower-pressure environment.",
        "context_based_connector": "You seem to connect best when there’s a shared reason to interact, such as classes, activities, or common interests. Structured settings may make social interaction easier.",
        "low_pressure_connector": "You appear to prefer spaces where interaction feels less intense, less public, and less judgment-heavy. Smaller groups or online-first settings may work best.",
        "direct_initiator": "You seem comfortable taking the first step in social situations. You may find it easier than most people to begin conversations and build momentum quickly.",
        "selective_socializer": "You are open to connection but prefer the right context. You may favor meaningful or relevant interactions rather than casual small talk."
    },
    "implementation_flow": [
        "Load survey answers",
        "Map answers to scoring rules",
        "Accumulate trait points",
        "Normalize scores to 0-100",
        "Assign interaction style",
        "Save result_profile",
        "Display result screen"
    ]
}